NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/barca_app
# Admin dashboard origins (comma separated)
CORS_ORIGIN=http://localhost:5173

# Separate secrets so a mobile token can never be used on the admin API
JWT_SECRET=change-me-at-least-32-characters-long
JWT_EXPIRES_IN=30d
ADMIN_JWT_SECRET=change-me-too-at-least-32-characters
ADMIN_JWT_EXPIRES_IN=12h

# First super admin, created at startup if no admin exists
SUPER_ADMIN_EMAIL=admin@barca.app
SUPER_ADMIN_PASSWORD=change-me

# Day boundaries for streaks, daily quiz and leaderboards
APP_TIMEZONE=Africa/Tunis
# ESPN fixture sync for predictions (minutes, 0 = disabled)
PREDICTIONS_SYNC_MINUTES=30
